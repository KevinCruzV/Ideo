# Copie ce fichier en .env et mets ta clé ElevenLabs (elevenlabs.io → Developers → API keys).
# .env n'est jamais commité. La variable d'environnement ELEVENLABS_API_KEY passe avant ce fichier,
# et ce fichier passe avant « elevenlabs_api_key » dans config.json.
# Le plus simple : .venv/bin/python -m ideo.cle (demande la clé sans l'afficher).
ELEVENLABS_API_KEY=
