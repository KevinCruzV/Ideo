{
  "name": "ideo-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts Short out/minimal.png --props=fixtures/minimal.json --frame=45",
    "render": "remotion render src/index.ts Short out/minimal.mp4 --props=fixtures/minimal.json",
    "stills": "node scripts/stills.mjs",
    "render:all": "remotion render src/index.ts Short out/all-scenes.mp4 --props=fixtures/all-scenes.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "flag-icons": "7.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@types/react": "19.3.0",
    "i18n-iso-countries": "7.14.0",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "world-atlas": "2.0.2"
  }
}
